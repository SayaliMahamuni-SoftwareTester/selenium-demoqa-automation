<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite" parallel="tests" thread-count="3">

  <listeners>
    <listener class-name="demoQA.testUtils.TestListener"/>
  </listeners>

  <test name="Chrome Test">
  <parameter name="browser" value="chrome"/>
    <classes>
      <class name="demoQA.testLayer.TextBoxTest"/>
      <class name="demoQA.testLayer.AlertTest"/>
      <class name="demoQA.testLayer.FrameTest"/>
      <class name="demoQA.testLayer.DatePickerTest"/>
      <class name="demoQA.testLayer.ProgressBarTest"/>
      <class name="demoQA.testLayer.UploadAndDownloadTest"/>
      <class name="demoQA.testLayer.SelectMenuTest"/>
      <class name="demoQA.testLayer.PracticeFormTest"/>
    </classes>
  </test> 
  
  <test name="Edge Test">
  <parameter name="browser" value="edge"/>
    <classes>
      <class name="demoQA.testLayer.TextBoxTest"/>
      <class name="demoQA.testLayer.AlertTest"/>
      <class name="demoQA.testLayer.FrameTest"/>
      <class name="demoQA.testLayer.DatePickerTest"/>
      <class name="demoQA.testLayer.ProgressBarTest"/>
      <class name="demoQA.testLayer.UploadAndDownloadTest"/>
      <class name="demoQA.testLayer.SelectMenuTest"/>
      <class name="demoQA.testLayer.PracticeFormTest"/>
    </classes>
  </test>
  
  <test name="Firefox Test">
  <parameter name="browser" value="firefox"/>
    <classes>
      <class name="demoQA.testLayer.TextBoxTest"/>
      <class name="demoQA.testLayer.AlertTest"/>
      <class name="demoQA.testLayer.FrameTest"/>
      <class name="demoQA.testLayer.DatePickerTest"/>
      <class name="demoQA.testLayer.ProgressBarTest"/>
      <class name="demoQA.testLayer.UploadAndDownloadTest"/>
      <class name="demoQA.testLayer.SelectMenuTest"/>
      <class name="demoQA.testLayer.PracticeFormTest"/>
    </classes>
  </test>
</suite> 
